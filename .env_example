# Select the provider group used by the app.
LLM_PROVIDER=bai

BAI_API_KEY=your_bai_api_key_here
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=gpt-5.2
BAI_REASONING_EFFORT=high

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
OPENAI_REASONING_EFFORT=

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=glm-4-7-251222

MINMAX_API_KEY=
MINMAX_BASE_URL=
MINMAX_MODEL=Minimax-M3

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MAX_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=300

ANNOTATION_API_KEY=
ANNOTATION_BASE_URL=
ANNOTATION_MODEL=
ANNOTATION_REASONING_EFFORT=

ENABLE_IMAGE_RESIZE=true
IMAGE_MAX_SIDE=768
IMAGE_JPEG_QUALITY=85

PORT=8000

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# You can keep this on 127.0.0.1, or switch to localhost if you prefer that browser host.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SESSION_SECRET_KEY=
REQUIRE_GOOGLE_LOGIN=true
